# Cognee MCP server for Railway, running in API mode against cognee-api.
# cognee-mcp has no 1.5.4 tag; main-<sha> tags are immutable builds of upstream main.
FROM cognee/cognee-mcp:main-e93a4f0

# Railway injects PORT; the upstream entrypoint listens on HTTP_PORT.
ENTRYPOINT ["sh", "-c", "export HTTP_PORT=${PORT:-8000}; exec /app/entrypoint.sh"]
